{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Study Quest",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8080"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Serving HTTP on.*",
                    "endsPattern": ".*"
                }
            }
        }
    ]
}